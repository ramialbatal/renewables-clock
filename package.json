{
  "name": "renewables-clock",
  "version": "1.0.0",
  "private": true,
  "description": "Live clock of the world's renewable electricity and progress toward tripling renewable capacity by 2030.",
  "type": "module",
  "license": "MIT",
  "author": "Rami Albatal",
  "repository": {
    "type": "git",
    "url": "https://github.com/ramialbatal/renewables-clock.git"
  },
  "homepage": "https://ramialbatal.github.io/renewables-clock/",
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json",
    "style": "node scripts/check-style.js",
    "smoke": "node scripts/smoke.js",
    "check": "npm run style && npm run typecheck && npm test",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "clock-core": "github:ramialbatal/clock-core#ec72aeee0db58f067da1658b766a21a229a991f1",
    "playwright": "1.48.2",
    "typescript": "5.6.3"
  },
  "smoke": {
    "ticking": [
      "#world-num",
      "#cap-now"
    ],
    "verdicts": [
      "#answer-title",
      "#cap-verdict"
    ],
    "hashes": [
      "#solar"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
